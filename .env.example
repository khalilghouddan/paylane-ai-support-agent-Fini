# Paylane AI Support Agent
# Copy this file to .env and adjust the values for your setup.

# LLM provider and API connection
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# Primary model, used for normal responses
LLM_PRIMARY_MODEL=llama3.2:3b

# Backup model, used if the primary model call fails
LLM_FALLBACK_MODEL=gemma3:1b

# For another OpenAI-compatible provider, update the provider, URL,
# API key, and model names above to match that provider.
